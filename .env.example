# =========================================================================
# Supabase Configuration Template (.env.example)
# Duplicate this file as .env.local and replace with your actual keys.
# =========================================================================

# Public Supabase URL (safe to expose to the browser via Next.js prefixes)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public Anon Key (used for browser transactions and real-time socket connections)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase Service Role Key (NEVER expose to the browser; used only in secure server actions)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
